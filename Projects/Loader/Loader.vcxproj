  <PropertyGroup Label="UserMacros" />
  <!-- The linker writes a plain PRX into the prx tree; the packaging step in
       Common.props derives the sprx tree's module from it, which is what the two
       Module properties below are for. Everything else is shared. -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)Build\bin\$(Configuration)\prx\CODPatch\Modules\</OutDir>
    <TargetExt>.prx</TargetExt>
    <ModulePackageDir>$(SolutionDir)Build\bin\$(Configuration)\sprx\CODPatch\Modules</ModulePackageDir>
    <!-- This one is loaded into the running game's process, so it is signed with the
         retail game authority and not the sys/internal + vsh one CODPatch uses. -->
    <ModuleAuthId>1010000001000003</ModuleAuthId>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>$(ModuleCommonLibs);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
