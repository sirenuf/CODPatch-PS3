  <PropertyGroup Label="UserMacros" />
  <!-- The linker writes a plain PRX into the prx tree; the packaging step in
       Common.props derives the sprx tree's plugin from it, which is what the two
       Module properties below are for. Everything else is shared. -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)Build\bin\$(Configuration)\prx\CODPatch\</OutDir>
    <TargetExt>.prx</TargetExt>
    <ModulePackageDir>$(SolutionDir)Build\bin\$(Configuration)\sprx\CODPatch</ModulePackageDir>
    <!-- CODPatch is a VSH plugin, so it keeps the sys/internal + vsh authority. -->
    <ModuleAuthId>1070000052000001</ModuleAuthId>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)vendor\VirtualShell\include;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(SolutionDir)vendor\VirtualShell\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- ps3ppuld resolves left to right, so the shared set comes first and the VSH
           exports, which depend on it, come after. -->
      <AdditionalDependencies>$(ModuleCommonLibs);-lvshtask_export_stub;-lpaf_export_stub;-lvshmain_export_stub;-lvshcommon_export_stub;-lstdc_export_stub;-lallocator_export_stub;-lsys_net_export_stub;-lxsetting_export_stub;-lsysPrxForUser_export_stub;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
